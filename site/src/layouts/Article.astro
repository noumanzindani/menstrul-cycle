---
import Base from './Base.astro'
import Disclaimer from '../components/Disclaimer.astro'
import ReviewNotice from '../components/ReviewNotice.astro'
import type { ArticleHeader } from '../lib/article-headers.ts'

interface Source { title: string; url: string }
interface Props {
  title: string; description: string; path: string
  author: string; reviewedBy: string
  datePublished: Date; dateModified: Date
  sources: Source[]
  header?: ArticleHeader
}
const p = Astro.props as Props
const fmt = (d: Date) => d.toISOString().slice(0, 10)
---
<Base
  title={p.title}
  description={p.description}
  path={p.path}
  type="article"
  article={{
    author: p.author, reviewedBy: p.reviewedBy,
    datePublished: p.datePublished, dateModified: p.dateModified,
  }}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Articles', path: '/articles' },
    { name: p.title, path: p.path },
  ]}
>
  <h1 class="display max-w-[20ch] text-[2.1rem] sm:text-[2.75rem]">{p.title}</h1>
  <p class="mt-4 text-sm text-ink-muted dark:text-white/60">
    By {p.author} · Published <time datetime={fmt(p.datePublished)}>{fmt(p.datePublished)}</time>
    · Updated <time datetime={fmt(p.dateModified)}>{fmt(p.dateModified)}</time>
  </p>
  <div class="mt-4"><ReviewNotice reviewedBy={p.reviewedBy} /></div>
  <Disclaimer kind="article" />
  {p.header && (
    <figure class="mt-10">
      <!--
        The figure is deliberately NOT clamped to the prose measure: these are
        authored at 1024px, the width of the content column, and squeezing one
        to 68ch renders its internal labels at about 8px.

        Intrinsic 2048x430 with w-full: the attributes are here so the browser
        reserves the right box before the bytes land (no layout shift), while
        the class decides how wide it actually draws. eager + high priority
        because this sits near the top and is usually the largest paint.
      -->
      <img
        src={p.header.src}
        alt={p.header.alt}
        width="2048"
        height="430"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full rounded-lg"
      />
    </figure>
  )}
  <article class="prose mt-10"><slot /></article>
  <section class="mt-14 max-w-[68ch] border-t border-outline pt-8 dark:border-white/10">
    <h2 class="display-sm text-2xl">Sources</h2>
    <ul class="mt-4 list-disc pl-5 leading-relaxed marker:text-menstrual">
      {p.sources.map((s) => (
        <li class="mt-2"><a href={s.url} rel="noopener" class="underline underline-offset-2">{s.title}</a></li>
      ))}
    </ul>
  </section>
</Base>
