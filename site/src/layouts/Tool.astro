---
import Base from './Base.astro'
import Faq from '../components/Faq.astro'
import Disclaimer from '../components/Disclaimer.astro'
import CycleFocus from '../components/CycleFocus.astro'
import type { FaqEntry } from '../types.ts'

type Phase = 'menstrual' | 'follicular' | 'ovulatory' | 'luteal' | 'fertile' | 'predicted'

interface Props {
  /** The SEO title: <=60 escaped characters, keyword-first, no brand suffix. */
  title: string
  /**
   * The heading a reader sees, when it should differ from the SEO title.
   *
   * These two jobs pull in opposite directions. A title competes in a search
   * result and is measured against a 60-character budget; an H1 introduces the
   * page to someone already on it. Forcing one string to do both is how a page
   * ends up headed "Pregnancy Weeks to Months — Exact Day Boundaries".
   */
  h1?: string
  description: string
  path: string
  faq: FaqEntry[]
  /** Which days of a 28-day cycle this calculator can speak to. */
  focus?: { from: number; to: number; color: Phase; label: string }
}

const { title, h1, description, path, faq, focus } = Astro.props as Props
const heading = h1 ?? title
---
<Base
  title={title}
  description={description}
  path={path}
  faq={faq}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Calculators', path: '/tools' },
    { name: heading, path },
  ]}
>
  <h1 class="display max-w-[18ch] text-[2.1rem] sm:text-[2.6rem]">{heading}</h1>
  {focus && (
    <CycleFocus
      from={focus.from} to={focus.to} color={focus.color} label={focus.label}
      class="mt-6 max-w-sm"
    />
  )}
  <div class="mt-8"><slot name="widget" /></div>
  <Disclaimer kind="tool" />
  <article class="prose"><slot /></article>
  <Faq items={faq} />
</Base>
