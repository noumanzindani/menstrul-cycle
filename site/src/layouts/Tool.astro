---
import Base from './Base.astro'
import Faq from '../components/Faq.astro'
import Disclaimer from '../components/Disclaimer.astro'
import CycleFocus from '../components/CycleFocus.astro'
import type { FaqEntry } from '../types.ts'

type Phase = 'menstrual' | 'follicular' | 'ovulatory' | 'luteal' | 'fertile' | 'predicted'

interface Props {
  title: string
  description: string
  path: string
  faq: FaqEntry[]
  /** Which days of a 28-day cycle this calculator can speak to. */
  focus?: { from: number; to: number; color: Phase; label: string }
}

const { title, description, path, faq, focus } = Astro.props as Props
---
<Base
  title={title}
  description={description}
  path={path}
  faq={faq}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Calculators', path: '/tools' },
    { name: title, path },
  ]}
>
  <h1 class="display max-w-[18ch] text-[2.1rem] sm:text-[2.6rem]">{title}</h1>
  {focus && (
    <CycleFocus
      from={focus.from} to={focus.to} color={focus.color} label={focus.label}
      class="mt-6 max-w-sm"
    />
  )}
  <div class="mt-8"><slot name="widget" /></div>
  <Disclaimer kind="tool" />
  <article class="prose"><slot /></article>
  <Faq items={faq} />
</Base>
