---
import Tool from '../../layouts/Tool.astro'
import IvfWidget from '../../components/IvfWidget.astro'
import { IVF_OFFSET } from '../../lib/pregnancy.ts'
import type { FaqEntry } from '../../types.ts'

/** Generated from IVF_OFFSET so the table cannot drift from the arithmetic. */
const OFFSETS = [2, 3, 4, 5, 6, 7].map((age) => ({
  age, offset: IVF_OFFSET[age], selectable: [3, 5, 6].includes(age),
}))

const faq: FaqEntry[] = [
  {
    q: 'How is an IVF due date calculated?',
    a: 'By counting forward from the transfer date. A pregnancy is conventionally dated as 266 days from fertilisation, so the number of days added to a transfer date is 266 minus the age of the embryo when it was transferred: 263 days for a day 3 transfer, 261 for a day 5, 260 for a day 6. The same date can also be reached by working back to a last-period-equivalent date, 14 days before fertilisation, and adding 280 days. Both routes give the same day, which is a useful check rather than a coincidence.',
  },
  {
    q: 'Is the calculation different for a frozen embryo transfer?',
    a: 'No. The arithmetic uses the age the embryo had reached at transfer, not how long it spent frozen, so a day 5 blastocyst thawed and transferred four years after it was created is dated exactly like a fresh day 5 transfer. What the freeze does change is the meaning of one output: the fertilisation-equivalent date this page reports is a derived reference point for counting, not the date your eggs were collected.',
  },
  {
    q: 'What if my embryo was transferred on day 2, day 4 or day 7?',
    a: 'The same rule applies — 266 minus the embryo age — which gives 264 days for a day 2 transfer, 262 for a day 4 and 259 for a day 7. This page offers day 3, day 5 and day 6 because those are the stages transfers are normally performed at; if yours was a different day, add 266 minus that day number to your transfer date, or ask your clinic, which will have dated it already.',
  },
  {
    q: 'Why is a due date from IVF firmer than one from a last period?',
    a: 'Because one source of uncertainty is removed rather than estimated. Dating from a last period assumes ovulation happened about 14 days in, and that assumption can be out by a week or more. With a transfer, the date of fertilisation is known to the day, so the gestational age count itself is exact. The birth date is not: pregnancy length varies between pregnancies regardless of how precisely it is dated, and very few births happen on the estimated date.',
  },
  {
    q: 'Why does the gestational age look higher than the time since my transfer?',
    a: 'Because gestational age is counted from a last-period-equivalent date, which sits 14 days before fertilisation. On the day of a day 5 transfer the count is already 19 days — 14 days plus the 5 days the embryo had developed. That is the convention antenatal care uses, so it is the figure that will match your maternity notes, but it is not the number of days since your transfer and reading it that way puts you about three weeks out.',
  },
  {
    q: 'Should I use this date or the one my clinic gave me?',
    a: 'Your clinic or maternity team, every time. They have your full record, including any dating scan, and their date is the one your care is planned around. This page does arithmetic on two things you typed in; it cannot see anything that has happened since your transfer, and it has no way to know whether the figures you entered match your paperwork.',
  },
  {
    q: 'Does this page tell me anything about how the pregnancy is going?',
    a: 'No. It converts dates into other dates. It has no information beyond the transfer date and the embryo age you entered, so it cannot say whether anything is as expected, and it does not describe a pregnancy as being in any particular state. Those descriptions belong to a care team that can see the whole picture.',
  },
]
---
<Tool
  title="IVF and FET Due Date Calculator — Day 3, 5 or 6"
  h1="IVF and FET due date calculator"
  description="Estimated due date from your embryo transfer date and the embryo age at transfer — day 3, day 5 or day 6 — with every whole-day offset shown."
  path="/tools/ivf-due-date-calculator"
  faq={faq}
>
  <IvfWidget slot="widget" />

  <p>
    An embryo transfer fixes the one date that dating from a last period has to
    estimate. Fertilisation is known to the day, so the count itself does not rest
    on an assumption about when ovulation happened. Enter your transfer date and
    the embryo age at transfer, and this page adds the whole-day offset for that
    age — and shows you every step it took, including the two reference dates the
    280-day convention is built on.
  </p>

  <h2>The arithmetic, in full</h2>
  <p>
    A pregnancy is conventionally dated as 280 days from the first day of the last
    menstrual period, and that date sits 14 days before fertilisation, so the same
    convention is 266 days from fertilisation. A transfer happens a known number of
    days after fertilisation, so the days to add to a transfer date are 266 minus
    the embryo age:
  </p>
  <div class="not-prose my-6 overflow-x-auto">
    <table class="w-full min-w-[26rem] border-collapse text-sm">
      <thead>
        <tr class="border-b border-outline text-left dark:border-white/15">
          <th class="py-2 pr-4 font-semibold">Embryo age at transfer</th>
          <th class="py-2 pr-4 font-semibold">Days to add</th>
          <th class="py-2 font-semibold">On this page</th>
        </tr>
      </thead>
      <tbody>
        {OFFSETS.map((o) => (
          <tr class="border-b border-outline/60 dark:border-white/10">
            <td class="py-2 pr-4">Day {o.age}</td>
            <td class="py-2 pr-4">266 − {o.age} = {o.offset}</td>
            <td class="py-2">{o.selectable ? 'Selectable' : 'Add it by hand'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p>
    Day 3, day 5 and day 6 are offered in the form because transfers are normally
    performed at those stages. The other rows follow the identical rule, so if
    yours was a day 2, day 4 or day 7 transfer you can add the offset to your
    transfer date directly.
  </p>
  <p>
    The page then works backward as well as forward, because the two reference
    dates are what make the result checkable. Subtracting the embryo age from the
    transfer date gives a fertilisation-equivalent date, and subtracting a further
    14 days gives a last-period-equivalent date. Adding 280 days to that second
    date lands on exactly the same due date as adding the offset to the transfer
    date. Every derived date on this page is measured from that same anchor, so if
    the anchor moves, all of them move together.
  </p>

  <h2>The fertilisation-equivalent date is a reference point, not an event</h2>
  <p>
    This is the output most worth reading carefully. The page reports a
    fertilisation-equivalent date because the 266-day convention needs one, and it
    is derived by subtracting the embryo age from the transfer date. For a fresh
    cycle that will land on or near the day of your egg collection. For a frozen
    transfer it will not: it is the point the embryo's development is counted
    from, not the date your eggs were collected, which may have been months or
    years earlier.
  </p>
  <p>
    The last-period-equivalent date is the same kind of thing, one step further
    back. For most people using this page there was no period that started on that
    day. It exists because antenatal care counts gestational age from such a date,
    and having it written down is what lets you reconcile this page's figures with
    the week and day in your maternity notes.
  </p>

  <h2>Why the gestational age is higher than you might expect</h2>
  <p>
    On the day of a day 5 transfer, the gestational age is already 19 days — 14
    days to the notional last period, plus the 5 days of embryo development. A
    reader who takes that figure as days since their transfer is out by three
    weeks. That is why the progress figures on this page are labelled as days of
    pregnancy counted from the last-period-equivalent date rather than as days
    elapsed, and why the as-of date is something you fill in deliberately rather
    than something the page assumes.
  </p>
  <p>
    That convention is not an eccentricity of this page — it is what your
    maternity notes will use, so it is the figure that will match when you compare
    them. The{' '}
    <a href="/tools/pregnancy-weeks-to-months" class="underline">weeks to months
    converter</a>{' '}
    takes a gestational age like that and turns it into a pregnancy month, if that
    is the part you came for.
  </p>

  <h2>Where these numbers come from</h2>
  <p>
    The 280-day convention counted from the first day of the last menstrual
    period, and the 14-day interval to fertilisation, are the dating conventions
    used in routine antenatal care — set out in the NICE antenatal care guideline
    in the UK and in guidance from the American College of Obstetricians and
    Gynecologists, which agree on both figures. Deriving 266 days from
    fertilisation, and the per-day transfer offsets in the table above, is
    arithmetic on those two conventions rather than a separate claim.
  </p>
  <p>
    The trimester boundaries this page reports — the second trimester at 14 weeks
    0 days, the third at 28 weeks 0 days — follow the common convention, but
    published boundaries vary a little between sources, so a figure within a few
    days of one may be described differently elsewhere. The gestational-age
    reference dates near the end of the pregnancy are shown as ages rather than
    names, and identically for every reader, because which of them applies to a
    given pregnancy is a description a care team gives.
  </p>

  <h2>Limitations worth reading before you use the answer</h2>
  <p>
    Knowing the fertilisation date exactly makes the gestational-age count exact.
    It does not make the birth date exact. Pregnancy length varies between
    pregnancies no matter how precisely the start is known, and very few births
    happen on the estimated date — the estimate is a planning reference, not a
    prediction of a day.
  </p>
  <p>
    This page keeps counting from the two things you typed and knows nothing about
    what has happened since your transfer. It cannot see a dating scan, a change
    to your care plan, or anything else, and it has no way to check that the
    transfer date and embryo age you entered match your paperwork. If your clinic
    or maternity team has given you a due date, theirs is the one your care is
    planned around and the one to use.
  </p>
  <p>
    Nothing here is a clinical assessment, and this page deliberately does not
    describe a pregnancy as being in any particular state. It subtracts dates.
    Whether a timing is expected, and what it would mean if it were not, are
    questions for a midwife or doctor.
  </p>

  <h2>Following it forward instead of re-typing it</h2>
  <p>
    Everything on this page is a snapshot of two dates. Pregnancy mode in the{' '}
    <a href="/features" class="underline">LunarFlow app</a>{' '}
    counts gestational age forward from a date you set once, so the week and day
    move on their own. The{' '}
    <a href="/tools/pregnancy-weeks-to-months" class="underline">weeks to months
    converter</a>{' '}
    covers the neighbouring question of what a given gestational age is in months.
  </p>
</Tool>

<!-- This page's island. See the note in Calculator.astro. -->
<script>
  import { mount } from '../../lib/island.ts'
  import { ivfDueDate } from '../../lib/pregnancy.ts'
  import { gaLabel } from '../../lib/gestation.ts'
  import { humanDate, requireDayWithin } from '../../lib/days.ts'
  import { hard, fixedExtent } from '../../lib/band.ts'
  import { track } from '../../lib/track.ts'
  import { ivfSummary } from '../../lib/summary/ivf.ts'

  const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`
  const esc = (s: string) => s.replace(/[&<>]/g, (c) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!)

  const ROW = 'mt-3 border-t border-outline pt-2 dark:border-white/15'
  const KEY = 'text-xs uppercase tracking-wide text-ink-muted dark:text-white/55'
  const row = (label: string, value: string) =>
    `<div class="${ROW}"><dt class="${KEY}">${label}</dt><dd class="mt-1">${value}</dd></div>`

  mount((v) => {
    const transfer = requireDayWithin(v.str('transfer'), 'Transfer date')
    // Coerced ONCE here; ivfDueDate allow-lists it and echoes it back, so no later
    // step re-reads the form and no string reaches the arithmetic. With a string,
    // `transfer - (age + 14)` concatenates and every derived date is 500 days out
    // while the headline due date still looks right.
    const asOf = v.str('asOf') === '' ? null : requireDayWithin(v.str('asOf'), 'As-of date')
    const r = ivfDueDate(transfer, Number(v.str('age')), asOf)

    // The two dated tables are already in the markup; fill their date cells.
    for (const el of document.querySelectorAll<HTMLElement>('#derived [data-offset]')) {
      el.textContent = humanDate(r.gestationalAnchor + Number(el.dataset.offset))
    }
    document.getElementById('derived')!.hidden = false

    let rows = row('Fertilisation-equivalent date (estimate)',
      `${humanDate(r.conceptionEquivalent)} — gestational day 14. A derived reference point, ` +
      `not a recorded event: for a frozen transfer this is the point the embryo's development ` +
      `is counted from, not the date of your egg collection.`) +
      row('Last-period-equivalent date (estimate)',
        `${humanDate(r.gestationalAnchor)} — gestational day 0. Adding 280 days to it gives ` +
        `the same due date.`)

    if (r.gestationalDaysAt !== null) {
      const left = r.dueDate - r.asOfDay!
      rows += row(`As of ${humanDate(r.asOfDay!)}`,
        `A pregnancy dated from this transfer would be ${gaLabel(r.gestationalDaysAt)} — ` +
        `${plural(r.gestationalDaysAt, 'day')} of pregnancy so far, counted from the ` +
        `last-period-equivalent date. ` + (left >= 0
          ? `${plural(left, 'day')} to the estimated due date.`
          : `${plural(-left, 'day')} past the estimated due date.`))
    }

    return `<h3 class="display-sm text-xl">Estimated due date: ${humanDate(r.dueDate)}</h3>` +
      `<p class="mt-1 text-sm text-ink-muted dark:text-white/60">Transfer date plus ` +
      `${r.offsetDays} days, which is 266 minus the day ${r.embryoAge} embryo age.</p>` +
      `<p class="mt-4 max-w-prose text-sm">Every date below is worked out from the same ` +
      `estimated anchor, so every one of them moves if the anchor moves.</p>` +
      `<dl class="mt-2">${rows}</dl>` +
      track(
        [
          { span: hard(0, 97), color: 'color-mix(in oklab, var(--color-predicted) 40%, transparent)' },
          { span: hard(98, 195), color: 'color-mix(in oklab, var(--color-predicted) 65%, transparent)' },
          { span: hard(196, 279), color: 'var(--color-predicted)' },
        ],
        'The three trimesters of the 280 days to the estimated due date, which is the ' +
        'right-hand end of the track. One neutral ramp, no marker: this is a scale, not a ' +
        'position.',
        fixedExtent(0, 279),
      ) +
      `<details class="mt-8 rounded-lg border border-outline p-3 dark:border-white/15">` +
      `<summary class="cursor-pointer text-sm font-semibold">Copy as text</summary>` +
      `<p class="mt-2 text-xs text-ink-muted dark:text-white/55">Select and copy. This is the ` +
      `text itself, not a link: nothing is uploaded.</p>` +
      `<pre class="mt-2 overflow-x-auto whitespace-pre-wrap text-xs">${esc(ivfSummary(r, humanDate))}</pre>` +
      `</details>`
  })
</script>
