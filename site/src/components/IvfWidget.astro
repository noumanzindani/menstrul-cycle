---
/**
 * The IVF and FET calculator's form, plus the two dated tables it fills in.
 *
 * The tables are rendered HERE, at build time, with their labels and their day
 * offsets in place and their date cells empty. The island writes only the dates,
 * by reading `data-offset` off each cell. Three reasons that is better than
 * building the tables in JavaScript:
 *
 * - The labels, the offsets and every class name stay out of the page's
 *   JavaScript. Generating these two tables in the island cost about 1.5 KB
 *   against an 8 KB per-route budget, for markup that never varies.
 * - `MILESTONES`, `TERM_REFERENCE` and `gaLabel` are then not in the bundle at all.
 * - The table structure is visible to anything reading the HTML.
 *
 * Two deliberate absences in the form:
 *
 * - **The embryo age has no preselected option.** Day 3 and day 5 transfers give
 *   due dates two days apart, and day 6 a third. Preselecting the commonest one
 *   would hand a wrong answer to everyone it does not apply to, with nothing on
 *   screen to show the assumption was made.
 * - **The as-of date is empty.** Pre-filling today turns a careful hypothetical
 *   into an unprompted live status readout, and some of the people reading this
 *   page are reading it after a pregnancy ended.
 */
import { fromDayNum, todayDayNum, PLAUSIBLE_FIRST_DAY_ISO } from '../lib/days.ts'
import { MILESTONES, TERM_REFERENCE, gaLabel } from '../lib/gestation.ts'
import ToolForm from './ToolForm.astro'

// A generous ceiling on the picker only. The island re-checks the range itself,
// because these attributes are baked in at build time and drift as a deploy ages.
const maxDate = fromDayNum(todayDayNum() + 400)

const TABLES = [
  {
    id: 'milestones',
    heading: 'Estimated milestone dates',
    note: 'Worked out from the same anchor as the due date. The trimester boundaries are a convention that varies a little between sources.',
    rows: MILESTONES.map(([label, offset]) => ({ label, offset })),
  },
  {
    id: 'reference',
    heading: 'Gestational-age reference dates for this anchor',
    note: 'These are the same ages for every pregnancy, converted to dates. Which of them applies to yours, and what it would mean, is a description your maternity team gives.',
    rows: TERM_REFERENCE.map((offset) => ({ label: gaLabel(offset), offset })),
  },
]
---
<ToolForm privacy="This runs entirely in your browser. The dates you type are never sent anywhere.">
  <label class="block font-semibold">
    Date of your embryo transfer
    <input type="date" name="transfer" required class="mt-2 block"
           min={PLAUSIBLE_FIRST_DAY_ISO} max={maxDate} />
  </label>

  <label class="mt-5 block font-semibold">
    Embryo age on the day of transfer
    <select name="age" required class="mt-2 block">
      <option value="">Choose one</option>
      <option value="3">Day 3 — cleavage stage</option>
      <option value="5">Day 5 — blastocyst</option>
      <option value="6">Day 6 — blastocyst</option>
    </select>
  </label>
  <p class="mt-2 max-w-prose text-xs text-ink-muted dark:text-white/55">
    This is on your transfer paperwork. For a frozen transfer it is the age the
    embryo had reached when it was frozen, not how long ago that was. A day 3 and
    a day 5 transfer on the same date give due dates two days apart.
  </p>

  <label class="mt-5 block font-semibold">
    Work the dates out as of (optional)
    <input type="date" name="asOf" class="mt-2 block"
           min={PLAUSIBLE_FIRST_DAY_ISO} max={maxDate} />
  </label>
  <p class="mt-2 max-w-prose text-xs text-ink-muted dark:text-white/55">
    Leave this empty for the dates alone. Fill it in to also see the gestational
    age a pregnancy dated from this transfer would have reached on that day.
  </p>
</ToolForm>

<div id="derived" hidden class="mt-8">
  {TABLES.map((t) => (
    <section class="mt-7 first:mt-0">
      <h3 class="display-sm text-lg">{t.heading}</h3>
      <p class="mt-1 max-w-prose text-sm text-ink-muted dark:text-white/60">{t.note}</p>
      <table class="mt-3 w-full border-collapse text-sm">
        <tbody>
          {t.rows.map((r) => (
            <tr class="border-b border-outline/60 dark:border-white/10">
              <td class="py-1.5 pr-4">{r.label}</td>
              <td class="py-1.5" data-offset={r.offset}></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}
</div>
