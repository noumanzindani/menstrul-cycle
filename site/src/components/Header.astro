---
import { NAV, ORG } from '../consts.ts'
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
---
<header class="sticky top-0 z-40 border-b border-outline bg-paper/85 backdrop-blur-sm dark:border-white/10 dark:bg-surface-dark/85">
  <nav aria-label="Main" class="mx-auto flex max-w-5xl flex-wrap items-baseline gap-x-6 gap-y-3 px-5 py-4">
    <a href="/" class="display-sm pressable text-xl tracking-tight hover:text-menstrual">{ORG.name}</a>
    <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
      {NAV.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={path === item.href ? 'page' : undefined}
            class="pressable -mb-px inline-block border-b-2 border-transparent pb-1 hover:border-menstrual aria-[current=page]:border-menstrual aria-[current=page]:font-semibold"
          >{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
