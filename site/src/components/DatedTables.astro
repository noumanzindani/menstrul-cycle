---
/**
 * The two dated tables both dating calculators show, rendered at BUILD time with
 * their labels and day offsets in place and their date cells empty.
 *
 * The island writes only the dates, by reading `data-offset` off each cell. Three
 * reasons that beats building the tables in JavaScript:
 *
 * - The labels, the offsets and every class name stay out of the page's bundle.
 *   Generating these two tables in the island cost about 1.4 KB against an 8 KB
 *   per-route budget, for markup that never varies.
 * - `MILESTONES`, `TERM_REFERENCE` and `gaLabel` are then not in the bundle at all.
 * - The structure is in the HTML, so anything reading the page can see it.
 *
 * The whole block ships `hidden` and the island reveals it: labels with no dates
 * beside them would read as a table that failed to load.
 *
 * The second table is deliberately STATIC — the same rows for every reader, one
 * neutral hue, never highlighted, never compared against an as-of date, and with
 * no distinct rendering at the last row. The moment a row lights up because the
 * reader has reached it, the table has become a risk gauge. Its rows are labelled
 * by gestational age rather than by name for the same reason: "full term" and
 * "post term" are states a care team assigns to a pregnancy.
 */
import { MILESTONES, TERM_REFERENCE, gaLabel } from '../lib/gestation.ts'

interface Props {
  /** Extra unconditional notes about the result, rendered above the tables. */
  notes?: string[]
}
const { notes = [] } = Astro.props as Props

const TABLES = [
  {
    heading: 'Estimated milestone dates',
    note: 'Worked out from the same anchor as the due date. The trimester boundaries are a convention that varies a little between sources.',
    rows: MILESTONES.map(([label, offset]) => ({ label, offset })),
  },
  {
    heading: 'Gestational-age reference dates for this anchor',
    note: 'These are the same ages for every pregnancy, converted to dates. Which of them applies to yours, and what it would mean, is a description your maternity team gives.',
    rows: TERM_REFERENCE.map((offset) => ({ label: gaLabel(offset), offset })),
  },
]
---
<div id="derived" hidden class="mt-8">
  {notes.length > 0 && (
    <section>
      <h3 class="display-sm text-lg">Notes on every date above</h3>
      {notes.map((n) => (
        <p class="mt-2 max-w-prose text-sm text-ink-muted dark:text-white/60">{n}</p>
      ))}
    </section>
  )}

  {TABLES.map((t) => (
    <section class="mt-7">
      <h3 class="display-sm text-lg">{t.heading}</h3>
      <p class="mt-1 max-w-prose text-sm text-ink-muted dark:text-white/60">{t.note}</p>
      <table class="mt-3 w-full border-collapse text-sm">
        <tbody>
          {t.rows.map((r) => (
            <tr class="border-b border-outline/60 dark:border-white/10">
              <td class="py-1.5 pr-4">{r.label}</td>
              <td class="py-1.5" data-offset={r.offset}></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}
</div>
