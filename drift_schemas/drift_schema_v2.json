  "fixed_sql": [
    {
      "name": "period_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"period_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"start_date\" INTEGER NOT NULL, \"end_date\" INTEGER NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "daily_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_logs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"date\" INTEGER NOT NULL, \"flow\" INTEGER NULL, \"symptoms\" TEXT NOT NULL DEFAULT '{}', \"mood\" TEXT NULL, \"notes\" TEXT NULL, \"bbt\" REAL NULL, \"opk\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), UNIQUE (\"date\"));"
        }
      ]
    },
    {
      "name": "reminders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reminders\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"type\" INTEGER NOT NULL, \"hour\" INTEGER NOT NULL, \"minute\" INTEGER NOT NULL, \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)), \"recurrence\" TEXT NULL, \"title\" TEXT NULL, \"payload\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "medications",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"medications\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"type\" TEXT NULL, \"schedule\" TEXT NULL, \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL DEFAULT 0, \"mode\" INTEGER NOT NULL DEFAULT 0, \"default_cycle_length\" INTEGER NOT NULL DEFAULT 28, \"default_period_length\" INTEGER NOT NULL DEFAULT 5, \"theme_mode\" TEXT NOT NULL DEFAULT 'system', \"language\" TEXT NOT NULL DEFAULT 'en', \"gender_neutral_language\" INTEGER NOT NULL DEFAULT 0 CHECK (\"gender_neutral_language\" IN (0, 1)), \"app_lock_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"app_lock_enabled\" IN (0, 1)), \"premium\" INTEGER NOT NULL DEFAULT 0 CHECK (\"premium\" IN (0, 1)), \"onboarding_complete\" INTEGER NOT NULL DEFAULT 0 CHECK (\"onboarding_complete\" IN (0, 1)), \"last_backup\" INTEGER NULL, \"pregnancy_start_date\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    }
