<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis=0: the widget is driven by app-side pushes (the countdown
     is computed in Dart), not periodic self-updates which would only re-render
     stale data. A daily background refresh is a documented follow-up. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/luna_widget"
    android:previewLayout="@layout/luna_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen">
</appwidget-provider>
