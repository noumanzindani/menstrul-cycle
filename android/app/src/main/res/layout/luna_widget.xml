<?xml version="1.0" encoding="utf-8"?>
<!--
  Both text rows deliberately use the SAME colour (@color/widget_on_background).
  Hierarchy is carried by size and weight (30sp bold vs 12sp), not by tone.

  The previous caption colour #6B4A56 was 3.30:1 on the widget card and failed
  WCAG AA. There is no fix by tone alone: on the brand pink the whole band
  between 4.5:1 and the value colour's 5.64:1 contains one indistinguishable
  shade. A "softer" caption colour here is a regression, not a refinement.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/luna_widget_background"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/widget_on_background"
        android:maxLines="1"
        tools:text="5" />

    <TextView
        android:id="@+id/widget_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:textColor="@color/widget_on_background"
        android:gravity="center"
        android:maxLines="2"
        tools:text="days to your period" />
</LinearLayout>
