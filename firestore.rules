rules_version = '2';

// LunaTrack — ruleset for the NAMED Firestore database `lunatrack`.
//
// ## Why this file is the entire privacy boundary
//
// The Firebase API key ships compiled inside the APK and is trivially
// extractable. Every consent gate the app implements — the claim prompt, the
// per-account claim record, `AppGate`'s ordering, `SyncTrigger`'s gates —
// governs the app's own behaviour and has ZERO authority over a raw HTTPS
// request to the Firestore REST API made with that key and any valid ID token.
// These rules are the only check that runs server-side, so they are written as
// if the client is hostile, because for this threat model it is.
//
// ## Why `request.auth != null` is NOT a security boundary here
//
// The Firebase project is shared with unrelated apps (see
// `lib/services/firestore_ref.dart`), so every one of THEIR users holds a valid
// `request.auth` token against this database. A bare "is signed in" check would
// hand one user's menstrual history to every account in the shared Auth pool.
// Every rule below therefore matches on IDENTITY — `request.auth.uid` against
// the uid in the document path — never merely on being signed in. That is also
// the correct rule in a dedicated project, so it stays either way.
//
// ## Default deny
//
// There is deliberately no `match /{document=**}` catch-all. Anything not
// matched below is denied, which is what keeps the ruleset to exactly the paths
// `SyncService` and `AccountDeletionService` actually use.
//
// Covered paths (verified against the code, not from notes):
//   users/{uid}                        AccountDeletionService.deleteFirestoreData (final delete)
//   users/{uid}/dailyLogs/{date}       SyncService._remoteLogs      (get/list/set/delete)
//   users/{uid}/settings/current       SyncService._remoteSettings  (get/set)
//   users/{uid}/deletions/{date}       SyncService._remoteDeletions (get/list/set/delete)
//   users/{uid}/devices/{deviceId}     SyncService._deviceDoc       (get/set-merge)
//   users/{uid}/reminders/{id}         SyncService._remoteReminders (get/list/set)
//   users/{uid}/medications/{id}       SyncService._remoteMedications (get/list/set)
//   users/{uid}/analysisSessions/{id}  SyncService._remoteSessions  (get/list/set)
//   users/{uid}/analysisMessages/{id}  SyncService._remoteMessages  (get/list/set/delete)
//   users/{uid}/media/{mediaId}        MediaSyncService             (get/list/set/delete)
//   deletionRequests/{uid}             AccountDeletionService       (get/create/delete)
service cloud.firestore {
  match /databases/{database}/documents {

    // The one identity check. Both halves matter: `request.auth != null` alone
    // is the single most common Firestore vulnerability, and the uid comparison
    // alone would throw on an unauthenticated request.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Everything the sync layer stores lives under the signed-in user's own
    // uid. `deleteFirestoreData` also deletes the `users/{uid}` document itself
    // after sweeping the subcollections, and `/users/{userId}/{document=**}`
    // does NOT match that parent document — hence the outer rule as well as the
    // recursive one.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // ENUMERATED, not `match /{document=**}`.
      //
      // The recursive wildcard was correct while every subcollection held the
      // same kind of data under the same rule. It stopped being correct when
      // media landed, for two reasons:
      //
      // 1. A wildcard match UNIONS with a specific one, so any validation
      //    written for `media` below would be dead — a write denied there is
      //    still allowed by the wildcard. Field validation on media is not
      //    decoration: it is what stops a download URL being stored.
      // 2. The wildcard also permits writing to a subcollection that does not
      //    exist in the code — and the purge sweeps a fixed list, so anything
      //    parked outside it survives "delete my account" forever.
      //
      // Adding a subcollection now means adding it here, to
      // `AccountDeletionService.subcollections`, and to `functions/purge.js`.
      // That is three places on purpose: each one is a promise about the data.
      match /dailyLogs/{date} {
        allow read, write: if isOwner(userId);
      }
      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /deletions/{date} {
        allow read, write: if isOwner(userId);
      }
      match /devices/{deviceId} {
        allow read, write: if isOwner(userId);
      }

      // v12 (2026-09-18): the owner asked for every table to be backed up,
      // reversing two local-only rulings. There is no `match /{document=**}`
      // catch-all in this file, so each new subcollection is denied to
      // everyone until it is named here — which is why they are enumerated
      // rather than globbed.
      match /reminders/{reminderId} {
        allow read, write: if isOwner(userId);
      }
      match /medications/{medicationId} {
        allow read, write: if isOwner(userId);
      }

      // Saved assistant conversations. The TEXT is what the user typed and
      // model-generated prose about their body, held here in plaintext exactly
      // as the consent sheet states. `isOwner` is the boundary, and in a
      // SHARED project `request.auth != null` would be no boundary at all —
      // every other app's users hold a valid token against this database.
      //
      // Since v16 a deleted conversation stays as a session TOMBSTONE (the
      // full v15 shape plus `deletedAt`, title removed) and its messages are
      // deleted; see `SyncService._pushAnalysis`.

      // One attachment reference at index [i], or nothing there. Rules cannot
      // loop, so `validMessage` calls this once per index up to the cap, and
      // `size() <= i` short-circuits past the end of the list.
      //
      // A reference is exactly `{mediaId, kind}`: never bytes, and never a
      // URL. `hasOnly` blocks a smuggled `url`/`downloadUrl` key, and the id
      // pattern (`newMediaId()`'s 32 lowercase hex) stops a URL being parked
      // in `mediaId` itself — the same reasoning as the `media` rules below,
      // for the same reason: a Storage download URL is a bearer credential.
      function validAttachmentAt(list, i) {
        return list.size() <= i
            || (list[i] is map
                && list[i].keys().hasOnly(['mediaId', 'kind'])
                && list[i].mediaId is string
                && list[i].mediaId.matches('^[0-9a-f]{32}$')
                && list[i].kind in ['image', 'video']);
      }

      // Every field a v15 or v16 client writes, and nothing else. `attachments`
      // and `includeInModel` are v16; a v15 message has neither, and passes.
      //
      // The cap of 6 references sits above `kMaxImagesPerMessage` (3) to
      // leave room for videos, which the assistant declines but still stores.
      // The composer must never allow more than this in one message: a
      // refused write is skipped by the sync, not retried.
      function validMessage() {
        let d = request.resource.data;
        return d.keys().hasOnly([
                 'sessionId', 'role', 'messageText', 'createdAt', 'updatedAt',
                 'syncedAt', 'attachments', 'includeInModel'
               ])
            && (!('attachments' in d)
                || (d.attachments is list
                    && d.attachments.size() <= 6
                    && validAttachmentAt(d.attachments, 0)
                    && validAttachmentAt(d.attachments, 1)
                    && validAttachmentAt(d.attachments, 2)
                    && validAttachmentAt(d.attachments, 3)
                    && validAttachmentAt(d.attachments, 4)
                    && validAttachmentAt(d.attachments, 5)));
      }

      // BEGIN live-analysis — replaced by the STAGED block below once enabled.
      match /analysisSessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }
      match /analysisMessages/{messageId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validMessage();
      }
      // END live-analysis

      // STAGED — enable only once the MINIMUM supported client is v16 or
      // later. To enable: delete the live-analysis block above and uncomment
      // this one (strip the leading `//S `). `firebase_test/rules.test.mjs`
      // derives exactly that ruleset and tests it, so the staged rules are
      // proven before anyone switches them on.
      //
      // Why not now: each clause refuses something a v15 client does as a
      // matter of course. v15 writes sessions with a blind whole-document
      // `set()` that drops `deletedAt` (it has never heard of it), and pushes
      // messages without knowing their session was deleted elsewhere. Denied,
      // that `set()` throws inside v15's `SyncService.syncNow`, which has no
      // per-document tolerance: the run aborts, its cursors never advance, and
      // every later sync stalls on the same document — the 2026-09-19 failure
      // again. Until then, the v16 client itself re-asserts a tombstone that a
      // stale v15 `set()` overwrote (`SyncService._applyRemoteSession`).
      //
      //S match /analysisSessions/{sessionId} {
      //S   allow read, delete: if isOwner(userId);
      //S   allow create, update: if isOwner(userId)
      //S       // A session names its owner, and it must be this path's owner.
      //S       && request.resource.data.uid == userId
      //S       // A tombstone stays a tombstone: no write may drop `deletedAt`.
      //S       && (resource == null
      //S           || !('deletedAt' in resource.data)
      //S           || 'deletedAt' in request.resource.data);
      //S }
      //S match /analysisMessages/{messageId} {
      //S   allow read, delete: if isOwner(userId);
      //S   allow update: if isOwner(userId) && validMessage();
      //S   // No new turn under a deleted conversation. A missing session is
      //S   // allowed: a device may push a message before its session lands.
      //S   allow create: if isOwner(userId) && validMessage()
      //S       && (!exists(/databases/$(database)/documents/users/$(userId)/analysisSessions/$(request.resource.data.sessionId))
      //S           || get(/databases/$(database)/documents/users/$(userId)/analysisSessions/$(request.resource.data.sessionId)).data.get('deletedAt', null) == null);
      //S }

      // Metadata for uploaded photos and videos. The BYTES live in Cloud
      // Storage under `storage.rules`; this is the index.
      match /media/{mediaId} {

        // A live item, or a tombstone. Both shapes are enumerated so nothing
        // else can be smuggled into a document the owner controls.
        function validMedia() {
          return request.resource.data.keys().hasOnly([
                   'id', 'kind', 'storagePath', 'thumbPath', 'bytes',
                   'width', 'height', 'durationMs', 'caption',
                   'capturedAt', 'createdAt', 'updatedAt', 'deviceId',
                   'syncedAt', 'deletedAt'
                 ])
              && request.resource.data.id == mediaId
              // The single most important clause in this block. A Firebase
              // download URL carries a token that security rules never
              // evaluate, does not expire, and works for anyone holding the
              // string — so one stored URL replicated into the (unencrypted)
              // Firestore SDK cache is a permanent public link to an intimate
              // photograph. The client is built never to call
              // `getDownloadURL()`; this is the half an attacker cannot skip.
              // Covered by `hasOnly` above, and stated separately because it is
              // a rule about MEANING, not shape — do not "simplify" it away.
              && !request.resource.data.keys().hasAny(['downloadUrl', 'downloadURL', 'url', 'token'])
              // Objects can only ever be claimed inside the writer's own
              // Storage prefix, so a document cannot point at another
              // account's bytes.
              && (!('storagePath' in request.resource.data)
                  || request.resource.data.storagePath is string
                     && request.resource.data.storagePath.matches('^users/' + userId + '/media/.*'))
              && (!('kind' in request.resource.data)
                  || request.resource.data.kind in ['image', 'video']);
        }

        allow get, list, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validMedia();
      }
    }

    // The purge job's work queue: one tiny marker per account that has asked to
    // be deleted. Top-level on purpose (see the class doc on
    // `AccountDeletionService`) — a flag under `users/{uid}` would force the
    // purge into a collection-group scan whose read path goes THROUGH menstrual
    // logs.
    match /deletionRequests/{userId} {

      // Exactly the three fields `AccountDeletionService.requestDeletion`
      // writes, and nothing else. `hasOnly` blocks a smuggled extra field (this
      // document is the one place an attacker could park data outside their own
      // subtree); `hasAll` blocks a partial marker that would read back as a
      // request with no deadline.
      function validRequest(uid) {
        return request.resource != null
               && request.resource.data.keys().hasOnly(['uid', 'requestedAt', 'purgeAfter'])
               && request.resource.data.keys().hasAll(['uid', 'requestedAt', 'purgeAfter'])
               && request.resource.data.uid == uid
               // Server-stamped, never client-chosen: the audit trail of WHEN
               // the request was made must not depend on a device clock. The
               // client writes `FieldValue.serverTimestamp()`, which resolves
               // to exactly `request.time`.
               && request.resource.data.requestedAt == request.time
               // `purgeAfter` IS computed from the client clock
               // (`requestedAt.add(graceWindow)`), so it is bounded here.
               // Unbounded, a client could set a purge date in the past (an
               // immediate purge — data destroyed with no grace window, the
               // cancel path never reachable) or centuries away (a marker that
               // suppresses sync forever and is never collected).
               // `AccountDeletionService.graceWindow` is 30 days; ±1 day
               // absorbs clock skew without letting the window be chosen.
               && request.resource.data.purgeAfter is timestamp
               && request.resource.data.purgeAfter > request.time + duration.value(29, 'd')
               && request.resource.data.purgeAfter < request.time + duration.value(31, 'd');
      }

      // Single-document read only — `SyncService.syncNow`'s gate and
      // `AccountSection`/`AppGate`'s pending-request panel.
      allow get: if isOwner(userId);

      // NEVER enumerable, not even by an owner. A `list` permission turns this
      // collection into a roster of every account pending deletion — a
      // membership list of this app's users, which for a menstrual tracker is
      // itself sensitive, plus the uid list needed to target them.
      allow list: if false;

      allow create: if isOwner(userId) && validRequest(userId);

      // Create-only. Re-requesting must not slide the deadline the user was
      // promised, and a bare `set()` on an existing document is an `update` in
      // rules terms — the client's own read-before-write narrows that race but
      // cannot close it, so this is the actual guarantee.
      allow update: if false;

      // The cancel path. `AccountSection._cancelDeletion` and
      // `AppGate`'s deletion-pending screen both call
      // `AccountDeletionService.cancelDeletion()`, which is a plain
      // `delete()` — denying deletes here would strand every user who
      // changed their mind inside the grace window, which is the whole point
      // of a soft delete. Deleting a missing document is not an error in
      // Firestore, so the documented idempotent double-cancel still works.
      allow delete: if isOwner(userId);

      // Defence in depth, required by review: whatever a client's SDK or a raw
      // REST call classifies a write as, it must still be a FIRST write. This
      // grants nothing the `create` rule above does not already grant (allow
      // rules union, and a write to a non-existent document IS a create) — it
      // exists so that no future edit to the create/update pair can
      // accidentally open an overwrite path. `request.resource != null` inside
      // `validRequest` keeps it out of the way of `delete`.
      allow write: if isOwner(userId)
                   && validRequest(userId)
                   && !exists(/databases/$(database)/documents/deletionRequests/$(userId));
    }
  }
}
